{
  "name": "SuperLcm",
  "version": "0.3.0-alpha.6",
  "description": "SuperLcm hierarchical context compaction and exact recall for DeepSeek Harness, backed by the durable DSH session log.",
  "type": "module",
  "main": "./src/engine.js",
  "exports": {
    ".": "./src/engine.js",
    "./tool": "./src/tool.js",
    "./core": "./src/core.js",
    "./marker": "./src/marker.js",
    "./store": "./src/store.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/",
    "src/",
    "docs/",
    "examples/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "test": "node ./scripts/test.mjs",
    "check": "node ./scripts/check.mjs",
    "validate": "npm run check && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context-compaction",
    "SuperLcm",
    "lossless-recall",
    "memory",
    "dag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ygc3817922006-sketch/SuperLcm.git"
  },
  "bugs": {
    "url": "https://github.com/ygc3817922006-sketch/SuperLcm/issues"
  },
  "homepage": "https://github.com/ygc3817922006-sketch/SuperLcm#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22.16.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction": { "optional": true },
    "@deepseek-ai/dsh-compaction-basic": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true }
  }
}